{
  "name": "copilot-pacer",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "Menu-bar / system-tray app that paces your GitHub Copilot credit usage against working days",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node --import tsx --test src/*.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "date-holidays": "^3.23.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
